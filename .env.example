# PrivacyUpdate AI Environment Configuration

# Flask Application Secret Key
SECRET_KEY=privacyupdate-ai-academic-project-secret-key-2026

# Database Path (default: data/privacyupdate.db)
DATABASE_PATH=data/privacyupdate.db

# File Uploads Directory
UPLOAD_FOLDER=uploads

# Firecrawl Web Scraping API (optional but recommended for production crawling)
# Get your free/paid key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# OpenAI API Key for intelligent privacy policy diff explanation and impact categorization
# Get your API key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-oss-120b
